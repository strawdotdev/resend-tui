{
  "name": "@strawdev/resend-tui",
  "version": "0.1.3",
  "description": "Read and inspect email from the Convex Resend component.",
  "homepage": "https://github.com/strawdotdev/resend-tui#readme",
  "bugs": "https://github.com/strawdotdev/resend-tui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strawdotdev/resend-tui.git"
  },
  "bin": {
    "resend-tui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "import": "./dist/links.js",
      "require": "./dist/links.cjs"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "check": "pnpm build && tsc --noEmit && oxlint . && oxfmt --check .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node tools/build-cjs.mjs && node tools/make-executable.mjs",
    "verify": "pnpm check && pnpm test",
    "test:integration": "pnpm build && node tools/component-proof.mjs",
    "test:package": "node tools/package-check.mjs",
    "test:git": "node tools/git-package-check.mjs",
    "release:prepare": "node tools/release-package.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.5.9",
    "@opentui/react": "0.5.9",
    "open": "10.2.0",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "esbuild": "0.28.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.0.0"
}
